# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=False

# Database Configuration
DB_NAME=ngtrydb
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=db
DB_PORT=5432

# Email Configuration
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_FROM=noreply@ngtry.com

# SMS Configuration
SMS_SEND_API_URL=https://your-sms-api-url.com
SMS_API_TOKEN=your-sms-api-token

# API Configuration
BASE_API_URL=http://127.0.0.1:8002

# Security Configuration
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3000

# Firebase Configuration (Optional - for push notifications)
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json
